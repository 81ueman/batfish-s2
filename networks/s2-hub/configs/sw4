hostname sw4

interface Loopback0
 ip address 10.0.5.1 255.255.255.255

interface Loopback1
 ip address 10.100.5.1 255.255.255.255

interface Loopback2
 ip address 10.100.5.2 255.255.255.255

interface GigabitEthernet0/0
 ip address 10.1.3.2 255.255.255.252

router bgp 65004
 bgp router-id 10.0.5.1
 network 10.0.5.1 mask 255.255.255.255
 network 10.100.5.1 mask 255.255.255.255
 network 10.100.5.2 mask 255.255.255.255
 neighbor 10.1.3.1 remote-as 65000
