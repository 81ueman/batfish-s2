interface Loopback1
 ip address 10.100.6.1 255.255.255.255

interface Loopback2
 ip address 10.100.6.2 255.255.255.255

interface GigabitEthernet0/0
 ip address 10.1.4.2 255.255.255.252

router bgp 65005
 bgp router-id 10.0.6.1
 network 10.0.6.1 mask 255.255.255.255
 network 10.100.6.1 mask 255.255.255.255
 network 10.100.6.2 mask 255.255.255.255
 neighbor 10.1.4.1 remote-as 65000
