load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

# Our own S2 implementation. Classes live in org.batfish.dataplane.ibdp so they
# can use package-private engine members, mirroring how the reference did it.
java_library(
    name = "s2",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "//projects/batfish",
        "//projects/common:common_lib",
        "@maven//:com_google_guava_guava",
        "@maven//:org_apache_logging_log4j_log4j_api",
    ],
)
